{
  "25": {
    "inputs": { "ckpt_name": "stable_audio_3_small_sfx.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Stable Audio 3 Small SFX (models/checkpoints)" }
  },
  "26": {
    "inputs": { "clip_name": "t5gemma_b_b_ul2.safetensors", "type": "stable_audio", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "T5Gemma (models/text_encoders)" }
  },
  "6": {
    "inputs": { "text": "{{sfx_prompt}}", "clip": ["26", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt dos efeitos" }
  },
  "7": {
    "inputs": { "text": "music, melody, singing, speech, voices, talking, hiss, distortion, low quality", "clip": ["26", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negativo" }
  },
  "11": {
    "inputs": { "seconds": "{{sfx_seconds}}", "batch_size": 1 },
    "class_type": "EmptyLatentAudio",
    "_meta": { "title": "Duração (s)" }
  },
  "3": {
    "inputs": { "seed": "{{seed}}", "steps": 50, "cfg": 7, "sampler_name": "lcm", "scheduler": "simple", "denoise": 1, "model": ["25", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["11", 0] },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (50 passos, CFG 7 — padrão do modelo)" }
  },
  "12": {
    "inputs": { "samples": ["3", 0], "vae": ["25", 2] },
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "Decodificar áudio" }
  },
  "57": {
    "inputs": { "filename_prefix": "audio/forge_sfx", "format": "flac", "audio": ["12", 0] },
    "class_type": "SaveAudioAdvanced",
    "_meta": { "title": "Salvar áudio" }
  }
}
